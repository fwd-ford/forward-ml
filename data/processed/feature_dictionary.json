  "engineered_targets": {
    "churned": {
      "definition": "days_since_last_service > 365",
      "reference_date": "max(ServiceDate) in dataset (NOT datetime.now())",
      "exclude_when": "tenure_days < 365 (insufficient observation window)",
      "expected_positive_rate": "30-40% of trainable VINs"
    },
    "at_risk": {
      "definition": "gap_last_days > 1.5 * gap_avg_days AND days_since_last_service > 90",
      "exclude_when": "events_count < 2"
    }
  },
  "k_means_features_recommended": [
    "events_count",
    "tenure_days",
    "gap_avg_days",
    "gap_last_days",
    "days_since_last_service",
