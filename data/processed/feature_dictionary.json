    "is_single_event_derived"
  ],
  "derived_features_to_add_in_notebook": {
    "age_at_last_service_days": "(last_service_date - sales_date).days",
    "km_per_month": "km_max / (tenure_days / 30)",
    "gap_last_vs_avg": "gap_last_days / gap_avg_days",
    "is_loyal_to_dealer": "primary_dealer_share > 0.8 (bool)",
    "is_warranty_active": "(last_service_date - warranty_start).days < 3*365 (bool)",
    "is_single_event": "events_count == 1 (bool)"
  },
  "data_quality_issues": {
